# syntax=docker/dockerfile:1.7
ARG OPENCODE_VERSION=2.0.27
ARG RUST_VERSION=1.99.0
ARG ANDROID_COMMANDLINE_TOOLS_VERSION=15859902
ARG ANDROID_COMMANDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583

FROM node:22-bookworm-slim AS base
ARG OPENCODE_VERSION
ENV HOME=/home/opencode \
    XDG_CONFIG_HOME=/home/opencode/.config \
    XDG_DATA_HOME=/home/opencode/.local/share \
    XDG_STATE_HOME=/home/opencode/.local/state

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates git curl unzip \
    && npm install --global "@opencode/cli@${OPENCODE_VERSION}" \
    && npm cache clean --force \
    && install -d -o 1000 -g 1000 \
        /home/opencode \
        /workspace \
        /home/opencode/.config/opencode \
        /home/opencode/.local/share/opencode \
        /home/opencode/.local/share/opencode/log \
        /home/opencode/.local/state/opencode \
        /home/opencode/.cache \
        /home/opencode/.gradle \
        /home/opencode/.android \
        /home/opencode/.cargo/registry \
        /home/opencode/.cargo/git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["opencode"]

FROM base AS android
ARG ANDROID_COMMANDLINE_TOOLS_VERSION
ARG ANDROID_COMMANDLINE_TOOLS_SHA256
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && mkdir -p /opt/android-sdk/cmdline-tools \
    && curl --fail --location --silent --show-error \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_COMMANDLINE_TOOLS_VERSION}_latest.zip" \
        --output /tmp/android-command-line-tools.zip \
    && echo "${ANDROID_COMMANDLINE_TOOLS_SHA256}  /tmp/android-command-line-tools.zip" | sha256sum --check --status \
    && unzip -q /tmp/android-command-line-tools.zip -d /tmp/android-command-line-tools \
    && mkdir -p /opt/android-sdk/cmdline-tools/latest \
    && mv /tmp/android-command-line-tools/cmdline-tools/* /opt/android-sdk/cmdline-tools/latest/ \
    && yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk --licenses >/dev/null \
    && /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk \
        "platform-tools" \
        "platforms;android-36" \
        "build-tools;36.0.0" \
    && rm -rf /tmp/android-command-line-tools /tmp/android-command-line-tools.zip /var/lib/apt/lists/* \
    && chown -R 1000:1000 /opt/android-sdk
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER 1000:1000

FROM base AS rust-agent
ARG RUST_VERSION
ENV CARGO_HOME=/home/opencode/.cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/home/opencode/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential clang cmake libclang-dev libssl-dev liburing-dev pkg-config protobuf-compiler \
    && mkdir -p /opt/rustup \
    && curl --fail --location --silent --show-error https://sh.rustup.rs --output /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_VERSION}" --component rustfmt --component clippy \
    && rm /tmp/rustup-init.sh \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R 1000:1000 /opt/rustup /home/opencode/.cargo
USER 1000:1000

FROM docker:29.9.0-cli AS docker-cli

FROM rust-agent AS test-environment
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
USER 1000:1000
