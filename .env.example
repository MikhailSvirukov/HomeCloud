# Fine-grained GitHub PAT for the selected public monorepo. Fill in .env; never commit the token.
GITHUB_MCP_TOKEN=github_pat_REPLACE_ME

# Passed to OpenCode for headless authentication. Keep the active .env untracked.
DEEPSEEK_API_KEY=deepseek_REPLACE_ME
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
DEFAULT_BRANCH=main

# Separate clones of the same public monorepo (relative to this compose directory).
ANDROID_CHECKOUT=../homecloud-clones/android
DISTRIBUTED_SERVER_CHECKOUT=../homecloud-clones/distributed-server
DEDICATED_SERVER_CHECKOUT=../homecloud-clones/dedicated-server
TEST_ENVIRONMENT_CHECKOUT=../homecloud-clones/test-environment

# Docker image/toolchain versions. Compose defaults are shown here for optional overrides.
# OPENCODE_VERSION=2.0.27
# RUST_VERSION=1.99.0
# ANDROID_COMMANDLINE_TOOLS_VERSION=15859902
