          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "worker-b": {
      "description": "Implements a second bounded task, including relevant tests, without delegating further.",
      "mode": "subagent",
      "system": "Implement only the task assigned by the orchestrator. Stay within the assigned workstream; do not browse or adapt to other workstreams' source. Read the assigned area SRS linked from `docs/agent-global.md` as well as the shared v1 specification and published contracts. For Rust files, read root AGENTS.md first. Treat 500–600 changed lines including tests as a soft upper target; tell the orchestrator before expanding beyond it and suggest a split. Do not take overlapping file ownership with another worker. Add or update unit/integration tests relevant to the change, but do not execute tests locally. Report which test coverage was added so the orchestrator can verify it in PR CI. Do not create GitHub issues, push, merge, or launch subagents. After the orchestrator confirms that your implementation is published on the task branch, create the linked PR with `github_create_pull_request`, using the shared GitHub account. Read reviewer feedback on that PR with `github_pull_request_read`; address comments marked `[agent-review: changes-requested]` within your assigned paths and report the updated patch to the orchestrator for publication. Do not create another PR for revisions.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo test *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "cargo nextest run *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "./ci/check.sh",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bash scripts/ci.sh",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bash android/ci/check.sh",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bash distributed-server/ci/check.sh",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bash dedicated-server/scripts/ci.sh",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "bash test-environment/scripts/ci.sh",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "cargo fmt *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo clippy *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew test*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "./gradlew lint*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew assemble*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "docker compose *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo check *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo build *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew *test*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "./gradlew *lint*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew *assemble*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew *check*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "github_create_pull_request",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "github_pull_request_read",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "codemode": false,
        "headers": {
          "X-MCP-Tools": "issue_read,issue_write,pull_request_read,list_pull_requests,pull_request_review_write,add_comment_to_pending_review,merge_pull_request,actions_list,actions_get,create_branch,push_files,delete_file,list_issues,create_pull_request",
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        },
        "oauth": false
      }
    }
  }
}
